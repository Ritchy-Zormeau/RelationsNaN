@model IEnumerable<RelationsNaN.Models.Game>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Image)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseYear)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Platforms)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                    <img src="@Html.DisplayFor(modelItem => item.Image)" alt="NoImage"  height="200"/>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReleaseYear)
            </td>
                <td>
                    @if (item.Genre != null)
                    {
                        @Html.DisplayFor(modelItem => item.Genre.Name)
                    }
                </td>
            

                <td>
                    @foreach (var platform in item.Platforms)
                    {
                        <span class="badge bg-primary">@platform.Name</span>
                    }
                </td>
                 <td>

                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
